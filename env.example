# Lula Monorepo Environment Variables

# Backend Configuration
NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/lula
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Database Configuration
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=lula

# API Configuration
API_BASE_URL=http://localhost:3002/api
SOCKET_URL=http://localhost:3002

# Admin Web Configuration
VITE_BACKEND_URL=http://localhost:3002
VITE_API_BASE_URL=http://localhost:3002/api

# Mobile Apps Configuration
EXPO_PUBLIC_API_URL=http://localhost:3002/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:3002

# Stream.io Configuration (if using)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# AWS Configuration (if using)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# Firebase Configuration (if using)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# MSG91 Configuration (for SMS)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=your-msg91-sender-id

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security Configuration
CORS_ORIGIN=http://localhost:3001,http://localhost:19006,http://localhost:19007
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log
